# --- Database ---
# Option A: full URL (wins if set to anything other than the sqlite default).
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/Medivoice2?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATABASE_URL=sqlite:///./medvoice.db

# Option B (recommended): split fields, used only while DATABASE_URL above
# is left at the sqlite default. Fill these in for SQL Server.
DB_SERVER=
DB_PORT=1433
DB_NAME=Medivoice2
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
